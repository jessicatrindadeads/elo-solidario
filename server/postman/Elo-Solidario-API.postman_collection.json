{
  "info": {
    "name": "Elo Solidário API",
    "description": "Coleção para documentar e testar a API REST publicada do Elo Solidário.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://elo-solidario-api.onrender.com/api" },
    { "key": "necessidadeId", "value": "00000000-0000-4000-8000-000000000001" }
  ],
  "item": [
    {
      "name": "Saúde da API",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Necessidades",
      "item": [
        {
          "name": "Listar e filtrar",
          "request": { "method": "GET", "url": "{{baseUrl}}/necessidades?prioridade=urgente&status=aberta" }
        },
        {
          "name": "Consultar por ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/necessidades/{{necessidadeId}}" }
        },
        {
          "name": "Cadastrar",
          "event": [{
            "listen": "test",
            "script": { "exec": ["if (pm.response.code === 201) {", "  pm.collectionVariables.set('necessidadeId', pm.response.json().data.id);", "}"] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"item\": \"Cobertores\",\n  \"categoria\": \"Outros\",\n  \"local\": \"Centro Comunitário\",\n  \"quantidade\": 20,\n  \"unidade\": \"unidades\",\n  \"prioridade\": \"importante\"\n}" },
            "url": "{{baseUrl}}/necessidades"
          }
        },
        {
          "name": "Atualizar",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"item\": \"Cobertores\",\n  \"categoria\": \"Outros\",\n  \"local\": \"Centro Comunitário\",\n  \"quantidade\": 20,\n  \"unidade\": \"unidades\",\n  \"prioridade\": \"importante\",\n  \"status\": \"atendida\"\n}" },
            "url": "{{baseUrl}}/necessidades/{{necessidadeId}}"
          }
        },
        {
          "name": "Excluir",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/necessidades/{{necessidadeId}}" }
        }
      ]
    },
    {
      "name": "Voluntários",
      "item": [
        { "name": "Listar", "request": { "method": "GET", "url": "{{baseUrl}}/voluntarios" } },
        {
          "name": "Cadastrar",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Nome do voluntário\",\n  \"email\": \"voluntario@example.com\",\n  \"telefone\": \"(13) 99999-9999\",\n  \"disponibilidade\": \"manha\"\n}" },
            "url": "{{baseUrl}}/voluntarios"
          }
        }
      ]
    },
    {
      "name": "Registrar interesse em doação",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"necessidadeId\": \"{{necessidadeId}}\",\n  \"nomeDoador\": \"Nome do doador\",\n  \"contato\": \"doador@example.com\",\n  \"quantidade\": 10\n}" },
        "url": "{{baseUrl}}/interesses-doacao"
      }
    }
  ]
}
